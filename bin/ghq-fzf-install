#!/bin/bash
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

ZSHRC="${ZDOTDIR:-$HOME}/.zshrc"
PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix 2>/dev/null)}" || {
  echo -e "${RED}Error: brew not found${NC}" >&2
  exit 1
}
INIT_FILE="$PREFIX/share/ghq-fzf/init.zsh"
SOURCE_LINE="source $INIT_FILE"

case "${1:-}" in
  --dry-run)
    echo -e "${CYAN}Dry run — would add to $ZSHRC:${NC}"
    echo -e "  $SOURCE_LINE"
    exit 0
    ;;
  --help|-h)
    echo -e "${BOLD}Usage:${NC} ghq-fzf-install [--dry-run]"
    echo ""
    echo "Adds ghq-fzf shell integration to ~/.zshrc."
    echo -e "  ${GREEN}Ctrl-G${NC}  launches the repository picker"
    echo ""
    echo -e "${BOLD}Customize key binding:${NC}"
    echo "  Add before the source line in ~/.zshrc:"
    echo -e "  ${CYAN}export GHQ_FZF_KEY='^t'${NC}"
    exit 0
    ;;
esac

if [[ ! -f "$INIT_FILE" ]]; then
  echo -e "${RED}Error: $INIT_FILE not found.${NC}" >&2
  echo -e "  Try: ${CYAN}brew reinstall masaki39/tap/ghq-fzf${NC}" >&2
  exit 1
fi

if grep -qF "share/ghq-fzf/init.zsh" "$ZSHRC" 2>/dev/null; then
  echo -e "${YELLOW}Already configured${NC} in $ZSHRC"
  exit 0
fi

if [[ ! -f "$ZSHRC" ]]; then
  echo -e "${CYAN}Creating $ZSHRC${NC}"
fi

printf '\n# ghq-fzf\n%s\n' "$SOURCE_LINE" >> "$ZSHRC"

echo -e "${GREEN}✓ Added to $ZSHRC${NC}"
echo -e "  $SOURCE_LINE"
echo ""
echo -e "Restart your shell or run: ${CYAN}source $ZSHRC${NC}"
