#!/bin/bash
set -euo pipefail

ZSHRC="${ZDOTDIR:-$HOME}/.zshrc"
PREFIX="$(brew --prefix)"
SOURCE_LINE="source $PREFIX/share/ghq-fzf/init.zsh"

case "${1:-}" in
  --dry-run)
    echo "Would add to $ZSHRC:"
    echo "  $SOURCE_LINE"
    exit 0
    ;;
  --help|-h)
    echo "Usage: ghq-fzf-install [--dry-run]"
    echo ""
    echo "Adds ghq-fzf shell integration to ~/.zshrc."
    echo "Ctrl-G will launch the repository picker after restarting your shell."
    echo "Customize the key with: export GHQ_FZF_KEY='^r'"
    exit 0
    ;;
esac

if grep -qF "share/ghq-fzf/init.zsh" "$ZSHRC" 2>/dev/null; then
  exit 0
fi

echo "" >> "$ZSHRC"
echo "# ghq-fzf" >> "$ZSHRC"
echo "$SOURCE_LINE" >> "$ZSHRC"
